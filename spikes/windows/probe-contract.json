{
  "contract_version": 2,
  "status": "executable alpha probes; see evidence.json for per-candidate results and blockers",
  "measurement": {
    "scope": "development-host; not clean Windows evidence",
    "script": "measure.ps1",
    "warm_launches": 10,
    "startup": "Process.Start to visible top-level HWND answering WM_NULL plus DwmFlush; not instrumented first-content-frame",
    "temp": "dedicated TEMP/TMP before/after snapshots; transient extraction remains unverified without event tracing",
    "release_readiness": "NO-GO"
  },
  "table": {"rows": 10000, "columns": 36, "cell": "TEST-R{row:05}-C{column:02}", "virtualized": true},
  "input": {"masked": true, "test_value": "TEST-INPUT-42!", "persist": false},
  "themes": ["light", "dark"],
  "tokens": {
    "light": {"background": "#FFFFFF", "foreground": "#171717", "focus": "#005FCC"},
    "dark": {"background": "#171717", "foreground": "#FFFFFF", "focus": "#80BFFF"}
  },
  "focus_order": ["input", "invoke", "theme", "table"],
  "boundary": {"name": "probe_core_version", "input": null, "output_u32": 1},
  "forbidden": ["cryptography", "mnemonics", "network", "persistent input", "clipboard"]
}
